# Copia este archivo a .env y ajusta los valores para desarrollo local.
# No commitear nunca el .env real (ver .gitignore).

PORT=3000

# Secreto para firmar los JWT emitidos por POST /api/auth/login.
# TODO: reemplazar por un valor fuerte y unico antes de cualquier
# despliegue real; nunca reutilizar este valor de ejemplo.
JWT_SECRET=mathquest-dev-secret-CHANGE-ME
JWT_EXPIRES_IN=1h

# Duracion (en horas) del registro guardado en la tabla `sesiones`.
# Debe mantenerse alineada con JWT_EXPIRES_IN.
SESSION_DURATION_HOURS=1

# Conexion a la base de datos PostgreSQL (ver docs/mathquest_init_schema.sql
# para el esquema completo de tablas: usuarios, sesiones, progreso).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres_dev_pw
DB_NAME=mathquest
